generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  MANAGER
  DEVELOPER
  CLIENT_USER
}

enum RequestCategory {
  FEATURE
  BUG
  CHANGE_REQUEST
  OTHER
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users           User[]
  clients         Client[]
  requests        Request[]
  activityHistory ActivityHistory[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  name           String   @db.VarChar(150)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?       @relation("ClientUsers", fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)

  createdRequests  Request[]         @relation("RequestCreator")
  assignedRequests Request[]         @relation("RequestAssignee")
  activityHistory  ActivityHistory[]
  refreshTokens    RefreshToken[]

  @@unique([id, organizationId])
  @@index([organizationId, role])
  @@index([clientId])
  @@map("users")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]       @relation("ClientUsers")
  requests     Request[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("clients")
}

model Request {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  clientId        String          @map("client_id") @db.Uuid
  createdById     String          @map("created_by_id") @db.Uuid
  assignedToId    String?         @map("assigned_to_id") @db.Uuid
  title           String          @db.VarChar(200)
  description     String          @db.Text
  category        RequestCategory
  priority        RequestPriority @default(MEDIUM)
  status          RequestStatus   @default(DRAFT)
  dueDate         DateTime?       @map("due_date") @db.Timestamptz(6)
  rejectionReason String?         @map("rejection_reason") @db.Text
  version         Int             @default(1)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation("RequestCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedTo   User?        @relation("RequestAssignee", fields: [assignedToId, organizationId], references: [id, organizationId], onDelete: Restrict)

  activityHistory ActivityHistory[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, clientId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, dueDate])
  @@index([organizationId, deletedAt])
  @@map("requests")
}

model ActivityHistory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  requestId      String         @map("request_id") @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  event          String         @db.VarChar(100)
  previousStatus RequestStatus? @map("previous_status")
  newStatus      RequestStatus? @map("new_status")
  metadata       Json           @default("{}") @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request      Request      @relation(fields: [requestId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, requestId, createdAt])
  @@index([actorId])
  @@map("activity_history")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
